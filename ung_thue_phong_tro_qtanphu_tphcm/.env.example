# Google Maps API Key
# Thay YOUR_GOOGLE_MAPS_API_KEY_HERE bằng API key thực của bạn
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Firebase API Key
# Thay YOUR_FIREBASE_API_KEY_HERE bằng Firebase API key thực của bạn
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE

# Environment
ENV=development

# Google Gemini API Key (Lấy từ https://aistudio.google.com)
# Thay YOUR_GEMINI_API_KEY_HERE bằng API key thực của bạn
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

